msgid "Signing password is required to decode the PKCS#12 file."
msgstr "Se requiere la contraseña para descifrar el archivo PKCS#12."

msgid "Error opening the signature, possibly the signature key has been entered incorrectly or the file is not supported: {}"
msgstr "Error al abrir la firma, es posible que la clave se haya ingresado incorrectamente o que el archivo no sea compatible: {}"

msgid "The PKCS#12 bundle does not contain a private key and certificate."
msgstr "El paquete PKCS#12 no contiene clave privada ni certificado."

msgid "The electronic signature expired on {} and the document cannot be signed. Upload a valid signature file in SRI Signature."
msgstr "La firma electrónica venció el {} y no se puede firmar el comprobante. Cargue un archivo de firma válido en Firma SRI."

msgid "No PKCS#12 signature content attached to SRI Signature document."
msgstr "No hay contenido de firma PKCS#12 adjunto al documento de Firma SRI."

msgid "Invalid Ecuadorian document number '{}'. Expected format '001-001-000000001'."
msgstr "Número de comprobante ecuatoriano inválido '{}'. Formato esperado '001-001-000000001'."

msgid "Access key payload must be exactly 48 numeric digits before check digit."
msgstr "La clave de acceso debe tener exactamente 48 dígitos numéricos antes del dígito verificador."

msgid "Complete document number must be 15 digits (got '{}')."
msgstr "El número de comprobante completo debe tener 15 dígitos (se recibió '{}')."

msgid "Company RUC must be 13 numeric digits (got '{}')."
msgstr "El RUC de la compañía debe tener 13 dígitos numéricos (se recibió '{}')."

msgid "SRI environment must be '1' (test) or '2' (production), got '{}'."
msgstr "El ambiente SRI debe ser '1' (pruebas) o '2' (producción), se recibió '{}'."

msgid "Document SRI code must be 2 digits (got '{}')."
msgstr "El código SRI del comprobante debe tener 2 dígitos (se recibió '{}')."

msgid "Numeric code must be 8 digits (got '{}')."
msgstr "El código numérico debe tener 8 dígitos (se recibió '{}')."

msgid "Unknown SRI service type: {}"
msgstr "Tipo de servicio SRI desconocido: {}"

msgid "Invalid tax identification '{}' for type '{}'."
msgstr "Identificación tributaria inválida '{}' para el tipo '{}'."

msgid "SRI emission code '{}' must be exactly 3 numeric digits."
msgstr "El código de emisión SRI '{}' debe tener exactamente 3 dígitos numéricos."

msgid "SRI sequence {} must be between 0 and {}."
msgstr "La secuencia SRI {} debe estar entre 0 y {}."

msgid "Cannot reinstall the chart: the company already has ledger entries."
msgstr "No se puede reinstalar el plan contable: la compañía ya tiene movimientos contables."

msgid "Missing account {} for tax template '{}'."
msgstr "Falta la cuenta {} para la plantilla de impuestos '{}'."
